<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhilian.zhilianbackend.mapper.DemandMapper">

    <resultMap id="DemandMarketVOMap" type="com.zhilian.zhilianbackend.dto.response.DemandMarketVO">
        <id column="id" property="id"/>
        <result column="title" property="title"/>
        <result column="description" property="description"/>
        <result column="expected_budget" property="expectedBudget"/>
        <result column="deadline" property="deadline"/>
        <result column="create_time" property="createTime"/>
        <association property="manufacture" javaType="com.zhilian.zhilianbackend.dto.response.ManufactureListVO">
            <id column="manu_id" property="id"/>
            <result column="company_name" property="companyName"/>
            <result column="region" property="region"/>
            <result column="scale" property="scale"/>
            <result column="product_type" property="productType"/>
            <result column="contact_person" property="contactPerson"/>
            <result column="contact_phone" property="contactPhone"/>
            <result column="logo" property="logo"/>
        </association>
        <!-- 标签不在 SQL 中映射，在 Service 中填充 -->
    </resultMap>

    <select id="selectMarketDemands" resultMap="DemandMarketVOMap">
        SELECT
        d.id,
        d.title,
        d.description,
        d.expected_budget,
        d.deadline,
        d.create_time,
        m.id AS manu_id,
        m.company_name,
        m.region,
        m.scale,
        m.product_type,
        m.contact_person,
        m.contact_phone,
        m.logo
        FROM demand d
        LEFT JOIN manufacture m ON d.manu_id = m.id
        WHERE d.deleted = #{notDeletedTime}
        AND d.audit_status = 'approved'
        AND d.status = 'published'
        AND m.deleted = #{notDeletedTime}
        AND m.audit_status = 'approved'
        <if test="keyword != null and keyword != ''">
            AND d.title LIKE CONCAT('%', #{keyword}, '%') ESCAPE '\\'
        </if>
        <if test="budgetMin != null">
            AND d.expected_budget &gt;= #{budgetMin}
        </if>
        <if test="budgetMax != null">
            AND d.expected_budget &lt;= #{budgetMax}
        </if>
        <if test="deadlineStart != null">
            AND d.deadline &gt;= #{deadlineStart}
        </if>
        <if test="deadlineEnd != null">
            AND d.deadline &lt;= #{deadlineEnd}
        </if>
        <if test="tagIds != null and tagIds.size() > 0">
            AND EXISTS (
            SELECT 1 FROM demand_tag dt
            WHERE dt.demand_id = d.id
            AND dt.deleted = #{notDeletedTime}
            AND dt.tag_id IN
            <foreach collection="tagIds" item="tagId" open="(" close=")" separator=",">
                #{tagId}
            </foreach>
            )
        </if>
        ORDER BY d.create_time DESC
    </select>
    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, manu_id, title, description, expected_budget, deadline, status, views, deleted, create_time, update_time
    </sql>

    <!-- 待审核需求分页查询结果映射（仅需求+企业） -->
    <resultMap id="PendingDemandVOMap" type="com.zhilian.zhilianbackend.dto.response.DemandPendingVO">
        <id column="id" property="id"/>
        <result column="manu_id" property="manuId"/>
        <result column="manu_name" property="manuName"/>
        <result column="title" property="title"/>
        <result column="description" property="description"/>
        <result column="expected_budget" property="expectedBudget"/>
        <result column="deadline" property="deadline"/>
        <result column="create_time" property="createTime"/>
        <!-- 标签不在 SQL 中关联，由 Service 层组装 -->
    </resultMap>

    <!-- 分页查询待审核需求（仅需求基本信息 + 企业名称，不含标签） -->
    <select id="selectPendingDemandPage" resultMap="PendingDemandVOMap">
        SELECT
            d.id,
            d.manu_id,
            m.company_name AS manu_name,
            d.title,
            d.description,
            d.expected_budget,
            d.deadline,
            d.create_time
        FROM demand d
                 LEFT JOIN manufacture m ON d.manu_id = m.id AND m.deleted =  #{notDeletedTime}
        WHERE d.deleted =  #{notDeletedTime}
          AND d.audit_status = 'pending'
        ORDER BY d.create_time DESC
    </select>

</mapper>