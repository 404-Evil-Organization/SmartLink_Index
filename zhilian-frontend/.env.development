# 后端 API 基础地址
# 开发环境可使用 http://localhost:8080/api（若后端端口不同请修改）
VITE_API_BASE_URL = /api

# 阿里云 OSS 访问域名（用于展示证书图片等）
# 如果使用 OSS，请填写实际的 Bucket 域名，例如：
VITE_OSS_BASE_URL = https://smartlink-index.oss-cn-guangzhou.aliyuncs.com

# 应用标题（显示在浏览器标签页）
VITE_APP_TITLE = 智链指数

# 是否启用 Mock 数据（true/false）
# 开发调试时可设为 true，模拟后端数据；生产环境或测试前后端联调时请设为 false
VITE_MOCK_ENABLED = true